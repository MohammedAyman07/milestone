# =============================================================================
# MILESTONE AI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your credentials.
# =============================================================================

# Application Canonical URL Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google Gemini AI Configuration (Server-Side Only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Supabase PostgreSQL, Auth & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." # Strict server-side only

# PayPal Sandbox Configuration (Strict Server-Side Only — No Client Exposure)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Orders v2 Idempotency Retention (Strict Server-Side Only)
# Default is 6 hours per standard PayPal Orders v2 specification.
# Extended retention (up to 72 hours) requires contractual enablement by a PayPal Account Manager.
# Do NOT set PAYPAL_EXTENDED_IDEMPOTENCY_CONFIRMED=true unless confirmed by PayPal.
PAYPAL_IDEMPOTENCY_RETENTION_HOURS=6
PAYPAL_EXTENDED_IDEMPOTENCY_CONFIRMED=false
